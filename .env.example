# Avera Frontend — environment variables
# Copy this file to `.env` and adjust the values as needed.
# This file is tracked by git; real secrets go in `.env`, which is gitignored.

# Base URL of the Avera backend API.
# The browser sends the session cookie here, so this origin must also be listed
# in the backend's WEB_ORIGIN allowlist or requests will be blocked by CORS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000